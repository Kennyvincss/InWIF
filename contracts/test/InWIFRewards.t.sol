pragma solidity 0.8.24;

import {Test} from "forge-std/Test.sol";
import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {IAccessControl} from "@openzeppelin/contracts/access/IAccessControl.sol";
import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
import {InWIFRewards} from "../src/InWIFRewards.sol";
import {MockERC20, FeeOnTransferERC20} from "./mocks/MockERC20.sol";
import {Merkle} from "./utils/Merkle.sol";

contract InWIFRewardsTest is Test {
    InWIFRewards rewards;
    MockERC20 wif;
    address admin = makeAddr("admin");
    address funder = makeAddr("funder");
    address alice = 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266;
    address bob = 0x70997970C51812dc3A010C7d01b50e0d17dc79C8;
    address carol = 0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC;
    uint64 deadline;

    function setUp() public {
        rewards = new InWIFRewards(admin);
        wif = new MockERC20("World is Flat", "WIF");
        wif.mint(funder, 1_000_000 ether);
        vm.prank(funder);
        wif.approve(address(rewards), type(uint256).max);
        deadline = uint64(block.timestamp + 30 days);
    }

    function _leaves(uint256 id) internal view returns (bytes32[] memory l) {
        l = new bytes32[](3);
        l[0] = Merkle.leaf(id, alice, 100);
        l[1] = Merkle.leaf(id, bob, 250);
        l[2] = Merkle.leaf(id, carol, 75);
    }

    function _create() internal returns (uint256 id) {
        vm.prank(admin);
        id = rewards.createCampaign(IERC20(address(wif)), Merkle.root(_leaves(1)), deadline, "ipfs://campaign-1");
    }

    function _fund(uint256 id, uint256 amt) internal {
        vm.prank(funder);
        rewards.fund(id, amt);
    }

    // -------- creation --------

    function test_createCampaign_onlyManager() public {
        vm.expectRevert(
            abi.encodeWithSelector(
                IAccessControl.AccessControlUnauthorizedAccount.selector, alice, rewards.CAMPAIGN_MANAGER_ROLE()
            )
        );
        vm.prank(alice);
        rewards.createCampaign(IERC20(address(wif)), bytes32(uint256(1)), deadline, "");
    }

    function test_createCampaign_validates() public {
        vm.startPrank(admin);
        vm.expectRevert(InWIFRewards.InvalidToken.selector);
        rewards.createCampaign(IERC20(address(0)), bytes32(uint256(1)), deadline, "");
        vm.expectRevert(InWIFRewards.InvalidToken.selector);
        rewards.createCampaign(IERC20(alice), bytes32(uint256(1)), deadline, "");
        vm.expectRevert(InWIFRewards.InvalidRoot.selector);
        rewards.createCampaign(IERC20(address(wif)), bytes32(0), deadline, "");
        vm.expectRevert(InWIFRewards.InvalidDeadline.selector);
        rewards.createCampaign(IERC20(address(wif)), bytes32(uint256(1)), uint64(block.timestamp), "");
        vm.stopPrank();
    }

    // -------- claims --------

    function test_claim_happyPath() public {
        uint256 id = _create();
        _fund(id, 425);
        bytes32[] memory p = Merkle.proof(_leaves(id), 1);
        vm.prank(bob);
        rewards.claim(id, 250, p);
        assertEq(wif.balanceOf(bob), 250);
        assertTrue(rewards.hasClaimed(id, bob));
        assertEq(rewards.remaining(id), 175);
        assertEq(rewards.liabilities(IERC20(address(wif))), 175);
    }

    // Proof generated by the inwif core package (OpenZeppelin StandardMerkleTree) must verify on-chain.
    function test_claim_withTypeScriptGeneratedProof() public {
        bytes32 tsRoot = 0x965c13968124afb121bd7a04ed35142fdd5ec0ba68d6714a85ed5bcbf5ee6e42;
        vm.prank(admin);
        uint256 id = rewards.createCampaign(IERC20(address(wif)), tsRoot, deadline, "");
        _fund(id, 425);
        bytes32[] memory p = new bytes32[](2);
        p[0] = 0x27916d30f33ca3f46626a37628c666b17d1b3dcee3df5d9352641157d3bcd449;
        p[1] = 0x75e7a2cdec28fd107fe166ddb5789548888caafcfc84e84d94df18f40602eb31;
        vm.prank(bob);
        rewards.claim(id, 250, p);
        assertEq(wif.balanceOf(bob), 250);
    }

    function test_claim_rejectsDoubleClaim() public {
        uint256 id = _create();
        _fund(id, 425);
        bytes32[] memory p = Merkle.proof(_leaves(id), 0);
        vm.startPrank(alice);
        rewards.claim(id, 100, p);
        vm.expectRevert(InWIFRewards.AlreadyClaimed.selector);
        rewards.claim(id, 100, p);
        vm.stopPrank();
    }

    function test_claim_rejectsWrongAmountOrAccount() public {
        uint256 id = _create();
        _fund(id, 425);
        bytes32[] memory p = Merkle.proof(_leaves(id), 0);
        vm.prank(alice);
        vm.expectRevert(InWIFRewards.InvalidProof.selector);
        rewards.claim(id, 101, p);
        vm.prank(bob);
        vm.expectRevert(InWIFRewards.InvalidProof.selector);
        rewards.claim(id, 100, p);
    }

    function test_claim_cannotExceedFunding() public {
        uint256 id = _create();
        _fund(id, 200); // underfunded
        vm.prank(bob);
        vm.expectRevert(InWIFRewards.InsufficientFunding.selector);
        rewards.claim(id, 250, Merkle.proof(_leaves(id), 1));
        // smaller claim still works
        vm.prank(alice);
        rewards.claim(id, 100, Merkle.proof(_leaves(id), 0));
    }

    function test_claim_afterDeadlineReverts() public {
        uint256 id = _create();
        _fund(id, 425);
        vm.warp(deadline + 1);
        vm.prank(alice);
        vm.expectRevert(InWIFRewards.ClaimWindowClosed.selector);
        rewards.claim(id, 100, Merkle.proof(_leaves(id), 0));
    }

    function test_claim_unknownCampaign() public {
        vm.expectRevert(InWIFRewards.UnknownCampaign.selector);
        rewards.claim(99, 1, new bytes32[](0));
    }

    function test_pause_blocksClaimsAndFunding() public {
        uint256 id = _create();
        _fund(id, 425);
        vm.prank(admin);
        rewards.pause();
        vm.prank(alice);
        vm.expectRevert(Pausable.EnforcedPause.selector);
        rewards.claim(id, 100, Merkle.proof(_leaves(id), 0));
        vm.prank(funder);
        vm.expectRevert(Pausable.EnforcedPause.selector);
        rewards.fund(id, 1);
        vm.prank(admin);
        rewards.unpause();
        vm.prank(alice);
        rewards.claim(id, 100, Merkle.proof(_leaves(id), 0));
    }

    // -------- funding --------

    function test_fund_isPublicAndEmits() public {
        uint256 id = _create();
        vm.expectEmit(true, true, false, true);
        emit InWIFRewards.CampaignFunded(id, funder, 500);
        _fund(id, 500);
        (,, uint256 funded,,,,) = rewards.campaigns(id);
        assertEq(funded, 500);
    }

    function test_fund_feeOnTransferCreditsActualReceived() public {
        FeeOnTransferERC20 fot = new FeeOnTransferERC20();
        fot.mint(funder, 10_000);
        vm.prank(funder);
        fot.approve(address(rewards), type(uint256).max);
        vm.prank(admin);
        uint256 id = rewards.createCampaign(IERC20(address(fot)), bytes32(uint256(1)), deadline, "");
        vm.prank(funder);
        rewards.fund(id, 1000);
        (,, uint256 funded,,,,) = rewards.campaigns(id);
        assertEq(funded, 990);
        assertEq(fot.balanceOf(address(rewards)), 990);
    }

    // -------- withdrawal --------

    function test_withdrawUnclaimed_onlyAfterDeadline() public {
        uint256 id = _create();
        _fund(id, 425);
        vm.prank(alice);
        rewards.claim(id, 100, Merkle.proof(_leaves(id), 0));

        vm.prank(admin);
        vm.expectRevert(InWIFRewards.ClaimWindowOpen.selector);
        rewards.withdrawUnclaimed(id, funder);

        vm.warp(deadline + 1);
        uint256 before = wif.balanceOf(funder);
        vm.prank(admin);
        rewards.withdrawUnclaimed(id, funder);
        assertEq(wif.balanceOf(funder) - before, 325);
        assertEq(rewards.liabilities(IERC20(address(wif))), 0);
        assertEq(rewards.remaining(id), 0);
    }

    function test_withdrawUnclaimed_onlyAdmin() public {
        uint256 id = _create();
        vm.warp(deadline + 1);
        vm.prank(alice);
        vm.expectRevert();
        rewards.withdrawUnclaimed(id, alice);
    }

    function test_campaignsAreIsolated() public {
        uint256 a = _create();
        uint256 b = _create();
        _fund(a, 425);
        // Campaign b is unfunded: a's deposits can't be used for b.
        bytes32[] memory leavesB = _leaves(1); // same root content but different id => leaf mismatch
        vm.prank(bob);
        vm.expectRevert(InWIFRewards.InvalidProof.selector);
        rewards.claim(b, 250, Merkle.proof(leavesB, 1));
    }

    // -------- fuzz --------

    function testFuzz_claimArbitraryAllocations(uint96 a1, uint96 a2, uint96 a3, uint256 extra) public {
        vm.assume(a1 > 0 && a2 > 0 && a3 > 0);
        extra = bound(extra, 0, 1e30);
        uint256 total = uint256(a1) + a2 + a3;
        wif.mint(funder, total + extra);
        vm.prank(admin);
        bytes32[] memory l = new bytes32[](3);
        l[0] = Merkle.leaf(1, alice, a1);
        l[1] = Merkle.leaf(1, bob, a2);
        l[2] = Merkle.leaf(1, carol, a3);
        uint256 id = rewards.createCampaign(IERC20(address(wif)), Merkle.root(l), deadline, "");
        _fund(id, total + extra);

        vm.prank(alice);
        rewards.claim(id, a1, Merkle.proof(l, 0));
        vm.prank(bob);
        rewards.claim(id, a2, Merkle.proof(l, 1));
        vm.prank(carol);
        rewards.claim(id, a3, Merkle.proof(l, 2));
        assertEq(rewards.remaining(id), extra);
        assertEq(wif.balanceOf(address(rewards)), extra);
    }

    function testFuzz_forgedProofsFail(bytes32 junk, uint256 amount) public {
        uint256 id = _create();
        _fund(id, 425);
        bytes32[] memory p = new bytes32[](1);
        p[0] = junk;
        vm.prank(alice);
        vm.expectRevert(InWIFRewards.InvalidProof.selector);
        rewards.claim(id, bound(amount, 1, type(uint128).max), p);
    }
}
