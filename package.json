{
  "name": "inwif",
  "private": true,
  "version": "0.1.0",
  "description": "InWIF \u2014 free, self-custody wallet ecosystem for Robinhood Chain and the World Is Flat ($WIF) community.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @inwif/web dev",
    "build": "pnpm -r --filter ./packages/** --filter @inwif/web --filter @inwif/api build",
    "test": "pnpm -r --filter ./packages/** --filter @inwif/web --filter @inwif/api test",
    "typecheck": "pnpm -r typecheck",
    "test:firmware": "cd firmware && cargo test"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "^8.5.32"
    }
  }
}
