{
  "expo": {
    "name": "InWIF",
    "slug": "inwif",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090B10",
    "ios": {
      "bundleIdentifier": "com.inwif.wallet",
      "infoPlist": { "NSFaceIDUsageDescription": "InWIF uses Face ID to unlock your wallet and approve transactions." }
    },
    "android": {
      "package": "com.inwif.wallet",
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT"],
      "allowBackup": false
    },
    "plugins": [["expo-secure-store", { "faceIDPermission": "InWIF uses Face ID to unlock your wallet." }], "expo-local-authentication"]
  }
}
